# Source distribution contents.
#
# Without this file setuptools falls back to the legacy distutils defaults,
# which pick up tests/test_*.py via a bare `test*.py` glob but silently DROP
# tests/conftest.py -- so the shipped test suite cannot run for anyone who
# builds from the sdist (downstream packagers: conda-forge, Debian, Spack).
# Note that a stale *.egg-info/SOURCES.txt in a working tree masks this, so
# always verify sdist contents from a pristine clone.

# Tests: every .py, conftest.py included.
recursive-include tests *.py

# Community, release, and citation metadata (README and LICENSE are automatic).
include CHANGELOG.md
include CITATION.cff
include CONTRIBUTING.md
include SECURITY.md

# Documentation sources, so the docs are reproducible from an sdist.
include docs/conf.py
include docs/index.md
recursive-include docs/user_guide *.md
recursive-include docs/api *.rst
recursive-include docs/examples *.md

# The example notebooks. docs/conf.py stages a subset of these into
# docs/examples/ at build time (docs/examples/*.ipynb is gitignored, which is
# why only *.md is listed above), so without the sources here the shipped
# docs/examples/index.md toctree would reference pages the tarball does not
# contain and a docs build from the sdist would fail.
recursive-include examples *.ipynb *.py

# Typing marker (also declared as package-data in pyproject.toml).
include impulse/py.typed

# Never ship build artifacts, caches, or local run output.
prune docs/_build
prune chains
prune prior_test
prune dist
prune build
global-exclude *.py[cod]
global-exclude .DS_Store
global-exclude *.ipynb_checkpoints
